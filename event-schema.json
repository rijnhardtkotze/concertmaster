{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concertmaster.co.za/schema/extracted-performance.json",
  "title": "Extracted Performance",
  "description": "One Performance as the model extracts it from one source document, with the fields of its Production alongside. A three-night run is three records that share their production fields. The pipeline computes everything else: identity keys, slugs, Venue resolution and which Composers are South African.",
  "type": "object",
  "properties": {
    "production": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "The Production's own name, not its Series."
        },
        "genre": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "chamber",
                "orchestral",
                "recital",
                "choral",
                "vocal",
                "contemporary",
                "early_music"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when no one Genre fits."
        },
        "series": {
          "type": [
            "string",
            "null"
          ]
        },
        "season": {
          "type": [
            "string",
            "null"
          ]
        },
        "presenter": {
          "description": "The organisation putting the Production on, by its full name.",
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Languages the Production is sung or performed in, as the source states. Empty for instrumental programmes."
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 400
            },
            {
              "type": "null"
            }
          ],
          "description": "A summary in your own words, 400 characters or fewer. Never the source's copy."
        },
        "credits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "person",
                  "ensemble"
                ]
              },
              "role": {
                "type": "string",
                "enum": [
                  "conductor",
                  "soloist",
                  "orchestra",
                  "ensemble",
                  "choir",
                  "chorus_master",
                  "director",
                  "narrator",
                  "accompanist",
                  "other"
                ]
              },
              "instrument": {
                "description": "For soloists and accompanists, including voice types such as soprano or baritone.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "locale": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "en-ZA"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "en-ZA only when the source says this Person is South African. Otherwise null. Always null for an Ensemble."
              }
            },
            "required": [
              "name",
              "kind",
              "role",
              "instrument",
              "locale"
            ],
            "additionalProperties": false,
            "description": "A Person or Ensemble credited on the Production, with the role they play."
          }
        },
        "programme": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "work"
                  },
                  "composer": {
                    "description": "Canonical full name where unambiguous. A bare ambiguous surname stays as written.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "catalogue": {
                    "description": "Op. 67, BWV 1043, K. 466, D. 759. Only when the source gives it.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "movements": {
                    "description": "Only when excerpts are performed.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "arranger": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "premiere": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "world",
                          "african",
                          "za",
                          "regional"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Only when the source states a premiere."
                  }
                },
                "required": [
                  "kind",
                  "composer",
                  "title",
                  "catalogue",
                  "movements",
                  "arranger",
                  "premiere"
                ],
                "additionalProperties": false,
                "description": "A Work on the Programme."
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "interval"
                  },
                  "minutes": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "minutes"
                ],
                "additionalProperties": false,
                "description": "An interval, in its place on the Programme."
              }
            ]
          },
          "description": "In the order the source gives. Empty when the source names no Works."
        }
      },
      "required": [
        "title",
        "genre",
        "series",
        "season",
        "presenter",
        "languages",
        "description",
        "credits",
        "programme"
      ],
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            {
              "type": "null"
            }
          ],
          "description": "YYYY-MM-DD, South African Standard Time."
        },
        "start_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ],
          "description": "HH:MM, 24-hour, South African Standard Time. Null when the source gives no time."
        },
        "doors_time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "venue": {
          "type": "object",
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "address": {
              "type": [
                "string",
                "null"
              ]
            },
            "city": {
              "type": [
                "string",
                "null"
              ]
            },
            "province": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "Gauteng",
                    "Western Cape",
                    "KwaZulu-Natal",
                    "Eastern Cape",
                    "Free State",
                    "Limpopo",
                    "Mpumalanga",
                    "North West",
                    "Northern Cape"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name",
            "address",
            "city",
            "province"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "few_left",
            "sold_out",
            "postponed",
            "cancelled"
          ]
        },
        "price_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "As the source names the tier, such as \"Adults\" or \"Pensioners and students\"."
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "In rand. Free entry is 0."
              }
            },
            "required": [
              "name",
              "amount"
            ],
            "additionalProperties": false,
            "description": "One named ticket price."
          },
          "description": "Empty when the source gives no price."
        },
        "ticket_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start_date",
        "start_time",
        "doors_time",
        "venue",
        "status",
        "price_tiers",
        "ticket_url"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Honest probability that every non-null field is correct as published."
    },
    "needs_review": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dotted paths of uncertain fields, such as performance.start_time or production.programme.1.composer."
    },
    "extraction_notes": {
      "description": "One line for the reviewer. Never shown on the site.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "production",
    "performance",
    "confidence",
    "needs_review",
    "extraction_notes"
  ],
  "additionalProperties": false
}
